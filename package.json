{
  "name": "tipshare",
  "version": "0.1.0",
  "description": "A shared, topic-based tips/lessons-learned knowledge base for AI agents (MCP server + SQLite).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tipshare": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
